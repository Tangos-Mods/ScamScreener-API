{$CADDY_SITE_ADDRESS:localhost} {
    encode zstd gzip

    @observability_blocked {
        path /api/v1/health /api/v1/metrics /api/internal/* /internal/*
        not remote_ip 127.0.0.1/32 ::1 private_ranges
    }
    respond @observability_blocked "Forbidden" 403

    @marketguard_api {
        path /api/v2/lowestbin /api/v1/bazaar /api/v1/players /api/v1/ready
    }

    handle_path /market* {
        reverse_proxy marketguard-hub:8082 {
            header_up Host {host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
        }
    }

    @marketguard_docs {
        path /docs /redoc /openapi.json
    }

    handle @marketguard_api {
        reverse_proxy scamscreener-api:8081 {
            header_up Host {host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
        }
    }

    handle @marketguard_docs {
        reverse_proxy scamscreener-api:8081 {
            header_up Host {host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
        }
    }

    handle {
        reverse_proxy scamscreener-hub:8080 {
            header_up Host {host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
        }
    }
}
